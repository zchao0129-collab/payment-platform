# ============================================================
# 生产环境配置
# 启动方式: npm run build       →  读取 .env.production
# 启动方式: npm run build:prod  →  读取 .env.production
# ============================================================

# API 基础路径 — Nginx 反向代理 /api → 后端，同域部署无需完整 URL
VITE_API_BASE_URL=/api

# 应用标题
VITE_APP_TITLE=支付商户管理平台
