# ============================================================
# 开发环境配置
# 启动方式: npm run dev  →  读取 .env.development（最高优先级）
# ============================================================

# API 基础路径 — Vite dev server 会代理 /api → 后端 :8080
VITE_API_BASE_URL=/api

# 后端代理目标
VITE_PROXY_TARGET=http://localhost:8080

# 应用标题
VITE_APP_TITLE=支付商户管理平台(Dev)
